# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión a PostgreSQL (valores de ejemplo, NO usar en producción)
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgres://tasks_user:change_me@localhost:5432/tasks_db

# Credenciales usadas por docker-compose.yml para levantar PostgreSQL local
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tasks_db
# Puerto del host donde docker-compose expone PostgreSQL (debe coincidir con DATABASE_URL)
POSTGRES_PORT=5432
